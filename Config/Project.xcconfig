// Build settings shared by all targets (the app, the unit tests and the UI tests) and all
// configurations. This file is the base configuration of the project, so every target inherits
// it; a setting in a target's own build settings overrides it, so do not repeat these there.
// Keep one commented block per topic.

// Version (see docs/development/process.md → Releases). MARKETING_VERSION is the version users
// see (CFBundleShortVersionString, semantic versioning); CURRENT_PROJECT_VERSION is the build
// number (CFBundleVersion, a positive integer), raised by one in every release pull request.
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// CloudKit sync needs a build signed with the paid Apple Developer team. Leave this NO for
// unsigned, ad-hoc (simulator) and free Personal Team builds; set it to YES in
// Config/Local.xcconfig (not in git) for the signed build. See docs/development/ios.md.
DA_CLOUDKIT_ENABLED = NO

// Appended to the app's bundle identifier (de.patrickklein.DocumentArchive$(DA_BUNDLE_ID_SUFFIX)).
// Empty for every real build. The sandboxed test build passes DA_BUNDLE_ID_SUFFIX=.SandboxTests,
// so it gets its own sandbox container and never creates the real app's container, which would
// stop the container migration of the first signed build. The test targets keep their own
// identifiers. The Keychain service name (KeychainStore.service) does not follow the suffix.
// See docs/development/index.md → Sandbox.
DA_BUNDLE_ID_SUFFIX =

// The container migration manifest (DocumentArchive/container-migration.plist) ships only in the
// real app, never in a build with a suffix. Its paths are relative to the home folder, not to the
// bundle identifier: in a sandboxed test build it would move the real archive into the TEST
// container on that build's first launch. Any non-empty suffix excludes it (the lookup of
// DA_CONTAINER_MIGRATION_KEEP_<suffix> is empty, so the default applies); only the empty suffix
// finds DA_CONTAINER_MIGRATION_KEEP_, a name that matches no file. ContainerMigrationTests and
// scripts/check-container-migration.py check both cases.
DA_CONTAINER_MIGRATION_KEEP_ = no-file-is-excluded
DA_CONTAINER_MIGRATION_EXCLUDED = $(DA_CONTAINER_MIGRATION_KEEP_$(DA_BUNDLE_ID_SUFFIX:identifier):default=container-migration.plist)
EXCLUDED_SOURCE_FILE_NAMES = $(inherited) $(DA_CONTAINER_MIGRATION_EXCLUDED)

// Optional local overrides, e.g. DEVELOPMENT_TEAM and DA_CLOUDKIT_ENABLED = YES. Keep this
// include last, so it overrides everything above.
#include? "Local.xcconfig"
