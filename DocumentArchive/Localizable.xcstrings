            "state": "translated",
            "value": "–"
          }
        }
      }
    },
    "“%@” (deleted)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ (gelöscht)"
          }
        }
      }
    },
    "“%@” could not be read.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ konnte nicht gelesen werden."
          }
        }
      }
    },
    "“%@” is not a PDF or an image.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist kein PDF oder Bild."
          }
        }
      }
    },
    "“%@” will be deleted on all devices.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ wird auf allen Geräten gelöscht."
          }
        }
      }
    },
    "“Automatic” straightens photographed pages and applies the filter when they are imported; the page is only cropped when it was detected reliably. PDFs and camera scans are not changed. Everything runs on this device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Automatisch“ richtet fotografierte Seiten beim Import gerade aus und wendet den Filter an; zugeschnitten wird nur, wenn die Seite sicher erkannt wurde. PDFs und Kamerascans bleiben unverändert. Alles läuft auf diesem Gerät."
          }
        }
      }
    },
