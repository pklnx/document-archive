      }
    },
    "These pages could not be read and were skipped: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Seiten konnten nicht gelesen werden und wurden übersprungen: %@"
          }
        }
      }
    },
    "These photos were already imported as “%@”.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Fotos wurden schon als „%@“ importiert."
          }
        }
      }
    },
    "This file is already in the archive and was skipped:": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei ist bereits vorhanden und wurde übersprungen:"
          }
        }
      }
    },
    "This version of the app is not signed with the iCloud entitlement. Your documents are only on this device. To sync with iPhone and iPad, sign the app in Xcode with your Apple Developer team (target “DocumentArchive” → Signing & Capabilities → Team). Your existing documents are uploaded automatically afterwards.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App-Version ist nicht mit iCloud-Berechtigung signiert. Deine Dokumente liegen nur auf diesem Gerät. Für den Abgleich mit iPhone und iPad muss die App in Xcode mit deinem Apple-Developer-Team signiert werden (Target „DocumentArchive“ → Signing & Capabilities → Team). Deine vorhandenen Dokumente werden danach automatisch hochgeladen."
          }
        }
      }
    },
